# DB_HOST="xxx.rds.amazonaws.com"
# DB_PORT="5432"
# DB_NAME="ethelius_admin"
# DB_USER=""
# DB_PASSWORD=""
SESSION_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
APP_URL="http://localhost:3000"
STORAGE_DIR="./storage"
# Production: store files in S3 instead (keys go under S3_KEY_PREFIX so the bucket can be shared).
