S3_BUCKET_NAME=""
# S3_KEY_PREFIX="ethelius-admin/"
# AWS_REGION="ap-south-1"            # plus AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an instance role
